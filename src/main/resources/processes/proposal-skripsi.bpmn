<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="proposal-skripsi-process" name="Pengajuan Proposal Skripsi UIN" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_1" name="Mahasiswa Mengajukan Proposal" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Verifikasi" />

    <bpmn:userTask id="Task_Verifikasi" name="Verifikasi Kelayakan oleh Sekretaris Prodi" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Verifikasi" targetRef="Gateway_Kelayakan" />

    <bpmn:exclusiveGateway id="Gateway_Kelayakan" name="Proposal Layak?" default="Flow_Ditolak" />
    <bpmn:sequenceFlow id="Flow_Disetuju" name="Ya" sourceRef="Gateway_Kelayakan" targetRef="Task_Review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasilVerifikasi == 'DISETUJUI'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ditolak" name="Tidak" sourceRef="Gateway_Kelayakan" targetRef="End_Ditolak" />

    <bpmn:userTask id="Task_Review" name="Review Dosen Pembimbing" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Review" targetRef="Task_Approval" />

    <bpmn:userTask id="Task_Approval" name="Persetujuan Ketua Prodi" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Approval" targetRef="EndEvent_1" />

    <bpmn:endEvent id="EndEvent_1" name="Proposal Disetujui &amp; SK Terbit" />
    <bpmn:endEvent id="End_Ditolak" name="Proposal Perlu Perbaikan" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="proposal-skripsi-process">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="173" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Verifikasi_di" bpmnElement="Task_Verifikasi">
        <dc:Bounds x="260" y="80" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Kelayakan_di" bpmnElement="Gateway_Kelayakan" isMarkerVisible="true">
        <dc:Bounds x="435" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="540" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Approval_di" bpmnElement="Task_Approval">
        <dc:Bounds x="710" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_End_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="880" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Ditolak_di" bpmnElement="End_Ditolak">
        <dc:Bounds x="540" y="230" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="209" y="120" />
        <di:waypoint x="260" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="390" y="120" />
        <di:waypoint x="435" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="660" y="120" />
        <di:waypoint x="710" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="830" y="120" />
        <di:waypoint x="880" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Disetuju_di" bpmnElement="Flow_Disetuju">
        <di:waypoint x="485" y="120" />
        <di:waypoint x="540" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ditolak_di" bpmnElement="Flow_Ditolak">
        <di:waypoint x="460" y="145" />
        <di:waypoint x="460" y="248" />
        <di:waypoint x="540" y="248" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>